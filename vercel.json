{
  "functions": {
    "api/generate.js": {
      "maxDuration": 180,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/publish.js": {
      "maxDuration": 60
    },
    "api/frame.js": {
      "maxDuration": 30
    },
    "api/can-frame.js": {
      "maxDuration": 30
    }
  },
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/((?!api/).*)"]
  }
}
